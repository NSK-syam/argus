# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
# Committed on purpose: NEXT_PUBLIC_* values are baked into the client
# bundle at build time and are public by definition, so the deployed
# backend's URL is not a secret. Having it here means a deploy doesn't
# silently fall back to http://localhost:8000 when a dashboard env var is
# missing. A real environment variable still overrides this file.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
